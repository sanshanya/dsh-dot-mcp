{
 "name": "dsh-dot-mcp",
 "version": "0.9.2",
 "description": "MCP bridge: exposes DeepSeek Harness (DSH) sessions, native goals, approvals and results to an MCP client through the official protocol. The bridge only connects; DSH keeps its session, agent, tool, approval and workspace security model.",
 "type": "module",
 "main": "./lib/index.js",
 "types": "./lib/types/index.d.ts",
 "exports": {
  ".": {
   "types": "./lib/types/index.d.ts",
   "default": "./lib/index.js"
  },
  "./client": "./lib/client.js",
  "./cordis.patch.yml": "./cordis.patch.yml",
  "./package.json": "./package.json"
 },
 "files": [
  "lib",
  "cordis.patch.yml",
  "cordis.headless.patch.yml",
  "README.md",
  "ARCHITECTURE.md",
  "LICENSE",
  "assets"
 ],
 "license": "MIT",
 "repository": {
  "type": "git",
  "url": "git+https://github.com/sanshanya/dsh-dot-mcp.git"
 },
 "homepage": "https://github.com/sanshanya/dsh-dot-mcp#readme",
 "bugs": {
  "url": "https://github.com/sanshanya/dsh-dot-mcp/issues"
 },
 "keywords": [
  "deepseek-harness",
  "dsh",
  "mcp",
  "dot-mcp",
  "chatgpt",
  "plugin"
 ],
 "engines": {
  "node": ">=22"
 },
 "dsh": {
  "bundle": {
   "patch": "./cordis.patch.yml"
  },
  "client": {
   "platform": "web",
   "inject": [
    "@deepseek-ai/dsh-api-remotes",
    "@deepseek-ai/dsh-client-locale",
    "@deepseek-ai/dsh-client-ui-slots",
    "@deepseek-ai/dsh-client-ui-settings",
    "@deepseek-ai/dsh-client-ui-settings-plugins"
   ]
  }
 },
 "scripts": {
  "build:server": "npm run clean && tsc -p tsconfig.json && node scripts/write-buildmeta.mjs",
  "build": "npm run build:server && npm run build:client && node scripts/write-buildmeta.mjs",
  "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
  "pretest": "npm run build",
  "test": "node scripts/test.mjs",
  "test:release": "node scripts/release-package-test.mjs",
  "prepublishOnly": "npm run clean && npm run build",
  "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true })\"",
  "test:live": "node --test test/live/*.test.mjs",
  "test:golden": "node scripts/golden-e2e.mjs",
  "build:client": "node scripts/build-client.mjs",
  "probe": "node scripts/probe-wire.mjs"
 },
 "dependencies": {
  "@deepseek-ai/schemastery": "~3.18.5",
  "@modelcontextprotocol/sdk": "1.30.0",
  "zod": "4.4.3",
  "@deepseek-ai/cosmokit": "~1.8.5"
 },
 "peerDependencies": {
  "@deepseek-ai/cordis": "~4.0.5",
  "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
  "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
  "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session-title": "0.2.1-rc.2"
 },
 "devDependencies": {
  "@deepseek-ai/cordis": "4.0.5",
  "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
  "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
  "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
  "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
  "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
  "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.2",
  "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
  "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
  "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
  "@types/node": "^24.0.0",
  "@types/react": "^19.3.0",
  "esbuild": "^0.28.2",
  "typescript": "^5.9.0"
 },
 "displayName": "DSH MCP Bridge (dsh-dot-mcp)"
}
