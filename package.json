{
  "name": "dsh-dot-mcp",
  "version": "0.7.0",
  "description": "MCP bridge: exposes DeepSeek Harness (DSH) sessions, native goals, approvals and results to an MCP client through the official protocol. The bridge only connects; DSH keeps its session, agent, tool, approval and workspace security model.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cordis.headless.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanshanya/dsh-dot-mcp.git"
  },
  "homepage": "https://github.com/sanshanya/dsh-dot-mcp#readme",
  "bugs": {
    "url": "https://github.com/sanshanya/dsh-dot-mcp/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mcp",
    "dot-mcp",
    "chatgpt",
    "plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:server": "npm run clean && tsc -p tsconfig.json",
    "build": "npm run build:server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "test:release": "node scripts/release-package-test.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true })\"",
    "test:live": "node --test test/live/*.test.mjs",
    "test:golden": "node scripts/golden-e2e.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2"
  }
}
